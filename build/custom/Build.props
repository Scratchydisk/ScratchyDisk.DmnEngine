<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
      ======================================================================================= 
      Customizable common properties to be shared between the projects within the solution
      =======================================================================================
    -->
  <PropertyGroup>
    <Authors>Stewart McSporran</Authors>
    <Company>ScratchyDisk</Company>
    <Copyright>Stewart McSporran 2024-2026</Copyright>
    <Description>DMN Engine is a rule engine that executes decisions defined in DMN models. It evaluates decision tables, expression decisions, boxed expressions, business knowledge models and decision services with a complete FEEL evaluator built on ANTLR4, resolves DMN imports, and supports DMN 1.1 through 1.6.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Scratchydisk/ScratchyDisk.DmnEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Scratchydisk/ScratchyDisk.DmnEngine.git</RepositoryUrl>
    <PushPackagesToVstsFeed>false</PushPackagesToVstsFeed>
  </PropertyGroup>
</Project>
